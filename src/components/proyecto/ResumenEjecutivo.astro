---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);
---

<div class="resumen-ejecutivo-seccion container">
  <div class="decoracion-azul">
    <img
      src="/img/decoracion-amarilla.png"
      alt="decoracion amarilla tipo estrella"
      class="img-decoracion-amarilla"
      width="400"
      height="400"
    />
  </div>
  <div class="resumen-ejecutivo">
    <h4>Resumen ejecutivo:</h4>
    <Content />
    <ul>
      {data.estado && <li>Estado de la discusión parlamentaria: {data.estado}</li>}
      {data.fechaPresentacion && <li>Fecha de presentación: {data.fechaPresentacion}</li>}
      {data.patrocinadores && data.patrocinadores.length > 0 && (
        <li>Patrocinadores: {data.patrocinadores.join(' | ')}</li>
      )}
      {data.comision && <li>Comisión: {data.comision}</li>}
      {data.enlaces?.map((enlace) => (
        <li>
          <a href={enlace.url} target="_blank" rel="noopener noreferrer">
            {enlace.texto}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>