---
const anio = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-decoracion">
    <img src="/img/collage-1-footer.png" alt="Megáfono izquierdo" class="img-1" width="380" height="150" />
    <img src="/img/slogan-footer.svg" alt="Slogan Democracia en juego" class="slogan" width="500" height="120" />
    <img src="/img/collage-2-footer.png" alt="Megáfono derecho" class="img-2" width="380" height="150" />
  </div>
  <div class="footer-contenido">
    <div class="informacion">
      <p>Un proyecto de:</p>
      <img src="/img/logo-fci.png" alt="Logo Ciudadanía Inteligente" width="150" height="50" />
      <img src="/img/logo-ct.png" alt="Logo Chile Transparente" width="150" height="50" />
      <img src="/img/logo-ue.png" alt="Logo del financista Unión Europea" width="150" height="50" />
    </div>
  </div>
  <div class="footer-bottom">
    <p>{anio} - Todos los derechos reservados</p>
  </div>
</footer>